{
  "name": "indesign-automation-framework",
  "version": "1.0.0",
  "description": "Production-grade, packagable InDesign UXP automation framework and AI toolkit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noremack/indesign-automation-framework.git"
  },
  "bugs": {
    "url": "https://github.com/Noremack/indesign-automation-framework/issues"
  },
  "homepage": "https://github.com/Noremack/indesign-automation-framework#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./mock": {
      "import": "./tests/mocks/indesign-mock.ts",
      "types": "./tests/mocks/indesign-mock.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "tools",
    "tests/mocks",
    "AI_MANIFESTO.json",
    "antigravity.rules.json",
    "app.config.json",
    "setup-framework.mjs",
    "README.md"
  ],
  "bin": {
    "indesign-scaffold": "./tools/scaffold.mjs"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build:script": "rollup -c --environment TARGET:script",
    "build:plugin": "rollup -c --environment TARGET:plugin",
    "build:lib": "rollup -c --environment TARGET:lib",
    "build": "rollup -c",
    "validate": "npm run type-check && npm run test:unit && npm run build",
    "scaffold": "node tools/scaffold.mjs",
    "prompt:pack": "node tools/pack-prompt.mjs",
    "context:extract": "node tools/extract-context.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-typescript": "^11.1.0",
    "@types/node": "^26.6.5",
    "rollup": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
